@implements IDisposable

@if (_visible)
{
    <div class='endgame-effect @(Result == EndGameResult.Win ? "win" : "lose")' aria-hidden="true">
        @if (Result == EndGameResult.Win)
        {
            <div class="endgame-banner win-banner">ПОБЕДА!</div>
            <div class="fireworks">
                @foreach (var burst in _bursts)
                {
                    <span class="firework" style="left:@(burst.Left)%; top:@(burst.Top)%; animation-delay:@(burst.DelayMs)ms"></span>
                }
            </div>
        }
        else if (Result == EndGameResult.Lose)
        {
            <div class="endgame-banner lose-banner">ХА-ХА</div>
            <div class="laugh-field">
                @foreach (var laugh in _laughs)
                {
                    <span class="laugh" style="left:@(laugh.Left)%; top:@(laugh.Top)%; animation-delay:@(laugh.DelayMs)ms">ха</span>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public EndGameResult Result { get; set; }
    [Parameter] public string? TriggerKey { get; set; }

    private readonly Random _random = new();
    private readonly List<EffectItem> _bursts = [];
    private readonly List<EffectItem> _laughs = [];
    private bool _visible;
    private string? _lastTriggerKey;
    private CancellationTokenSource? _cts;

    protected override void OnParametersSet()
    {
        if (Result == EndGameResult.None) return;
        if (string.IsNullOrWhiteSpace(TriggerKey)) return;
        if (string.Equals(_lastTriggerKey, TriggerKey, StringComparison.Ordinal)) return;

        _lastTriggerKey = TriggerKey;
        _visible = true;
        _bursts.Clear();
        _laughs.Clear();

        if (Result == EndGameResult.Win)
        {
            for (var i = 0; i < 32; i++)
                _bursts.Add(new EffectItem(_random.Next(6, 94), _random.Next(8, 78), i * 70));
        }
        else if (Result == EndGameResult.Lose)
        {
            for (var i = 0; i < 52; i++)
                _laughs.Add(new EffectItem(_random.Next(4, 92), _random.Next(8, 86), i * 55));
        }

        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        _ = HideLater(_cts.Token);
    }

    private async Task HideLater(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(3000, cancellationToken);
            _visible = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }

    private readonly record struct EffectItem(int Left, int Top, int DelayMs);
}
